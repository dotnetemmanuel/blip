# Copy to .blip.toml at your repo root and commit it.
# Credentials never live here: they go in ~/.config/blip/credentials.toml.

name = "orders"          # cache key and display name, required
default_env = "dev"

[env.dev]
base_url = "https://localhost:7284"
spec_url = "/openapi/v1.json"   # optional; omit and blip probes the usual paths
insecure = true                 # skip TLS verify, accepted only for localhost
auth     = "orders-dev"         # profile name in credentials.toml
timeout  = "30s"

[env.prod]
base_url = "https://api.example.internal"
auth     = "orders-prod"
readonly = true                 # hard-blocks every non-GET/HEAD/OPTIONS

# Client certificates, when a service sits behind mTLS. Relative paths resolve
# against this file, not the working directory.
# [env.staging]
# base_url    = "https://staging.example.internal"
# client_cert = "certs/client.pem"
# client_key  = "certs/client.key"

# Hand-declared routes, for an API with no spec or an endpoint the spec forgot.
# A route with no group becomes a top-level command: blip health
# [[route]]
# name    = "health"
# method  = "GET"
# path    = "/healthz"
# summary = "Liveness probe"

# [[route]]
# name   = "reindex"
# method = "POST"
# path   = "/admin/reindex/{tenant}"
# group  = "admin"
